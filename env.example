# Environment Variables Example
# Copy this file to .env and configure for your environment

# ===== LOCAL DEVELOPMENT =====

# Option 1: SQLite (for Electron/Desktop development)
# DATABASE_URL="file:./dev.db"

# Option 2: PostgreSQL (local development)
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# Option 3: Neon PostgreSQL (web / Vercel)
# DATABASE_URL = pooled connection (hostname contains -pooler)
# DIRECT_URL   = unpooled connection (same host without -pooler), used for prisma db push
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ===== PRODUCTION (VERCEL) =====
# Set these in the Vercel Dashboard (Settings → Environment Variables):
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# JWT_SECRET="replace-with-a-long-random-secret"

# ===== OTHER SETTINGS =====
NODE_ENV="development"

# Optional: Skip environment validation during development
SKIP_ENV_VALIDATION="true"

# JWT
JWT_SECRET="your-secret-key-change-this-in-production"

# ===== PRODUCT LICENSE (PunsookTechLicenseAPI) =====
# Server-side only — never expose LICENSE_VALIDATION_KEY to the client
LICENSE_API_URL="https://license-api.punsookinnotech.co"
# Project validation key (sent as X-Validation-Key on GET /api/v1/validate/{key}/offline)
LICENSE_VALIDATION_KEY="your-project-validation-key"
# Project public key PEM (RSA) used to verify signed .lkey offline files.
# Use literal \n for newlines if your env loader does not support multiline values.
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkq...\n-----END PUBLIC KEY-----"

# Optional: skip remote license checks in local development
# SKIP_LICENSE_CHECK="true"
