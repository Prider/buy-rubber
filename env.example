# Environment Variables Example
# Copy this file to .env and configure for your environment

# ===== LOCAL DEVELOPMENT =====

# Option 1: SQLite (local development)
# DATABASE_URL="file:./dev.db"

# Option 2: PostgreSQL (local development)
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# Option 3: Neon PostgreSQL (web / Vercel)
# DATABASE_URL = pooled connection (hostname contains -pooler)
# DIRECT_URL   = unpooled connection (same host without -pooler), used for prisma db push
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ===== PRODUCTION (VERCEL) =====
# Set these in the Vercel Dashboard (Settings → Environment Variables):
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# JWT_SECRET="replace-with-a-long-random-secret"

# ===== OTHER SETTINGS =====
NODE_ENV="development"

# Optional: Skip environment validation during development
SKIP_ENV_VALIDATION="true"

# JWT
JWT_SECRET="your-secret-key-change-this-in-production"

# Password reset email (Hostinger SMTP)
# mail.hostinger.com is webmail; outgoing mail uses smtp.hostinger.com
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@yourdomain.com"
SMTP_PASS="your-mailbox-password"
SMTP_FROM="you@yourdomain.com"
APP_URL="http://localhost:3000"

# Multi-tenant
DEFAULT_TENANT_SLUG="demo"
PLATFORM_OWNER_USERNAME="owner"
PLATFORM_OWNER_PASSWORD="owner123"
