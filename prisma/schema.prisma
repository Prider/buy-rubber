// This is your Prisma schema file

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "darwin", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  address   String?
  plan      String   @default("freemium") // freemium | premium
  status    String   @default("active") // active | pending_payment | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  members                  Member[]
  destinationCompanies     DestinationCompany[]
  productTypes             ProductType[]
  productPrices            ProductPrice[]
  purchases                Purchase[]
  expenses                 Expense[]
  serviceFees              ServiceFee[]
  settings                 Setting[]
  backups                  Backup[]
  sales                    Sale[]
  stockPositions           StockPosition[]
  stockLedgerEntries       StockLedgerEntry[]
  stockGangs               StockGang[]
  reportProductTypeGroups  ReportProductTypeGroup[]
  paymentRequests          PaymentRequest[]

  @@index([status])
  @@index([plan])
}

model PlatformUser {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSettings {
  id              String   @id @default("default")
  bankName        String   @default("")
  accountName     String   @default("")
  accountNumber   String   @default("")
  promptPayId     String   @default("")
  qrImage         Bytes?
  qrImageMimeType String?
  premiumPriceThb Float    @default(0)
  updatedAt       DateTime @updatedAt
}

model PaymentRequest {
  id           String    @id @default(uuid())
  tenantId     String
  amount       Float
  status       String    @default("pending") // pending | approved | rejected
  slipImage    Bytes
  slipMimeType String
  note         String?
  rejectReason String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, createdAt])
}

model User {
  id        String     @id @default(uuid())
  tenantId  String
  username  String
  password  String
  role      String     @default("user") // root, admin, user, viewer
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  sales     Sale[]

  @@unique([tenantId, username])
  @@index([tenantId])
}

model Member {
  id             String     @id @default(uuid())
  tenantId       String
  code           String
  name           String
  idCard         String?
  phone          String?
  address        String?
  bankAccount    String?
  bankName       String?
  ownerPercent   Float      @default(100)
  tapperPercent  Float      @default(0)
  tapperId       String?
  tapperName     String?
  advanceBalance Float      @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases      Purchase[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model DestinationCompany {
  id        String   @id @default(uuid())
  tenantId  String
  code      String
  name      String
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales     Sale[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ProductType {
  id                 String                         @id @default(uuid())
  tenantId           String
  code               String
  name               String
  description        String?
  isActive           Boolean                        @default(true)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  tenant             Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productPrices      ProductPrice[]
  purchases          Purchase[]
  sales              Sale[]
  stockPositions     StockPosition[]
  stockLedgerEntries StockLedgerEntry[]
  stockGangs         StockGang[]
  reportGroupMembers ReportProductTypeGroupMember[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ProductPrice {
  id            String      @id @default(uuid())
  tenantId      String
  date          DateTime
  productTypeId String
  price         Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@unique([date, productTypeId])
  @@index([tenantId])
  @@index([date])
}

model Purchase {
  id              String      @id @default(uuid())
  tenantId        String
  purchaseNo      String
  date            DateTime    @default(now())
  memberId        String
  productTypeId   String
  userId          String
  grossWeight     Float
  containerWeight Float       @default(0)
  netWeight       Float
  rubberPercent   Float?
  dryWeight       Float
  basePrice       Float
  adjustedPrice   Float
  bonusPrice      Float       @default(0)
  finalPrice      Float
  totalAmount     Float
  ownerAmount     Float
  tapperAmount    Float       @default(0)
  isPaid          Boolean     @default(false)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member          Member      @relation(fields: [memberId], references: [id])
  productType     ProductType @relation(fields: [productTypeId], references: [id])
  user            User        @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, purchaseNo])
  @@index([purchaseNo])
  @@index([date])
  @@index([memberId])
  @@index([productTypeId])
  @@index([memberId, date])
  @@index([date, createdAt])
  @@index([date, purchaseNo])
  @@index([date, purchaseNo, memberId])
}

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  expenseNo   String
  date        DateTime @default(now())
  category    String
  amount      Float
  description String?
  userId      String
  userName    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, expenseNo])
  @@index([tenantId])
  @@index([date])
  @@index([category])
  @@index([userId])
}

model ServiceFee {
  id           String   @id @default(uuid())
  tenantId     String
  serviceFeeNo String
  purchaseNo   String?
  date         DateTime @default(now())
  category     String
  amount       Float
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceFeeNo])
  @@index([tenantId])
  @@index([date])
  @@index([purchaseNo])
  @@index([category])
}

model Setting {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Backup {
  id         String   @id @default(uuid())
  tenantId   String
  fileName   String
  filePath   String
  fileSize   Int
  backupType String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fileName])
  @@index([tenantId])
  @@index([createdAt])
  @@index([backupType])
}

model Sale {
  id                   String               @id @default(uuid())
  tenantId             String
  saleNo               String
  date                 DateTime             @default(now())
  userId               String
  companyName          String
  destinationCompanyId String?
  productTypeId        String
  weight               Float
  rubberPercent        Float?
  pricePerUnit         Float
  expenseType          String?
  expenseCost          Float?
  sellingType          String
  totalAmount          Float
  unitCostPerKg        Float?
  costOfGoods          Float?
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User                 @relation(fields: [userId], references: [id])
  productType          ProductType          @relation(fields: [productTypeId], references: [id])
  destinationCompany   DestinationCompany?  @relation(fields: [destinationCompanyId], references: [id])
  expenses             SaleExpense[]

  @@unique([tenantId, saleNo])
  @@index([tenantId])
  @@index([date])
  @@index([userId])
  @@index([productTypeId])
  @@index([saleNo])
  @@index([destinationCompanyId])
  @@index([date, createdAt])
}

model SaleExpense {
  id        String @id @default(uuid())
  saleId    String
  type      String
  amount    Float
  note      String?
  sortOrder Int    @default(0)
  sale      Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model StockPosition {
  id            String      @id @default(uuid())
  tenantId      String
  productTypeId String      @unique
  quantityKg    Float       @default(0)
  avgCostPerKg  Float       @default(0)
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  @@index([tenantId])
}

model StockLedgerEntry {
  id                  String      @id @default(uuid())
  tenantId            String
  productTypeId       String
  refType             String
  refNo               String?
  refId               String?
  qtyChangeKg         Float
  unitCostPerKg       Float?
  totalCost           Float?
  balanceQtyKg        Float
  balanceAvgCostPerKg Float
  date                DateTime
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productType         ProductType @relation(fields: [productTypeId], references: [id])

  @@index([tenantId])
  @@index([productTypeId])
  @@index([productTypeId, date, createdAt])
  @@index([productTypeId, refType])
  @@index([date])
  @@index([refType])
  @@index([refType, refNo])
  @@index([refId])
}

model StockGang {
  id            String      @id @default(uuid())
  tenantId      String
  productTypeId String
  gangNo        Int
  startDate     DateTime
  endDate       DateTime?
  soldKg        Float       @default(0)
  cogs          Float       @default(0)
  saleNosJson   String      @default("[]")
  salesCount    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  @@unique([productTypeId, gangNo])
  @@index([tenantId])
  @@index([productTypeId, gangNo])
  @@index([productTypeId, startDate])
}

model ReportProductTypeGroup {
  id           String                         @id @default(uuid())
  tenantId     String
  name         String?
  kind         String                         @default("purchase")
  sortOrder    Int                            @default(0)
  isActive     Boolean                        @default(true)
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  tenant       Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productTypes ReportProductTypeGroupMember[]

  @@index([tenantId])
  @@index([kind, isActive, sortOrder])
  @@index([isActive, sortOrder])
}

model ReportProductTypeGroupMember {
  id            String                 @id @default(uuid())
  groupId       String
  productTypeId String
  group         ReportProductTypeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  productType   ProductType            @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@unique([groupId, productTypeId])
  @@index([groupId])
  @@index([productTypeId])
}
