generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "darwin"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  password  String
  role      String     @default("user")
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
  sales     Sale[]
}

model Member {
  id             String     @id @default(uuid())
  code           String     @unique
  name           String
  idCard         String?
  phone          String?
  address        String?
  bankAccount    String?
  bankName       String?
  ownerPercent   Float      @default(100)
  tapperPercent  Float      @default(0)
  tapperId       String?
  tapperName     String?
  advanceBalance Float      @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  purchases      Purchase[]
}

model ProductType {
  id                 String             @id @default(uuid())
  code               String             @unique
  name               String
  description        String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  productPrices      ProductPrice[]
  purchases          Purchase[]
  sales              Sale[]
  stockPositions     StockPosition[]
  stockLedgerEntries StockLedgerEntry[]
}

model ProductPrice {
  id            String      @id @default(uuid())
  date          DateTime
  productTypeId String
  price         Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@unique([date, productTypeId])
  @@index([date])
}

model Purchase {
  id              String      @id @default(uuid())
  purchaseNo      String
  date            DateTime    @default(now())
  memberId        String
  productTypeId   String
  userId          String
  grossWeight     Float
  containerWeight Float       @default(0)
  netWeight       Float
  rubberPercent   Float?
  dryWeight       Float
  basePrice       Float
  adjustedPrice   Float
  bonusPrice      Float       @default(0)
  finalPrice      Float
  totalAmount     Float
  ownerAmount     Float
  tapperAmount    Float       @default(0)
  isPaid          Boolean     @default(false)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  member          Member      @relation(fields: [memberId], references: [id])
  productType     ProductType @relation(fields: [productTypeId], references: [id])
  user            User        @relation(fields: [userId], references: [id])

  @@index([purchaseNo])
  @@index([date])
  @@index([memberId])
}

model Expense {
  id          String   @id @default(uuid())
  expenseNo   String   @unique
  date        DateTime @default(now())
  category    String
  amount      Float
  description String?
  userId      String
  userName    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([userId])
}

model ServiceFee {
  id           String   @id @default(uuid())
  serviceFeeNo String   @unique
  purchaseNo   String?
  date         DateTime @default(now())
  category     String
  amount       Float
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@index([purchaseNo])
  @@index([category])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Backup {
  id         String   @id @default(uuid())
  fileName   String   @unique
  filePath   String
  fileSize   Int
  backupType String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([backupType])
}

model Sale {
  id            String      @id @default(uuid())
  saleNo        String      @unique
  date          DateTime    @default(now())
  userId        String
  companyName   String
  productTypeId String
  weight        Float
  rubberPercent Float?
  pricePerUnit  Float
  expenseType   String?
  expenseCost   Float?
  sellingType   String
  totalAmount   Float
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id])
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  @@index([date])
  @@index([userId])
  @@index([productTypeId])
  @@index([saleNo])
}

model StockPosition {
  id            String      @id @default(uuid())
  productTypeId String      @unique
  quantityKg    Float       @default(0)
  avgCostPerKg  Float       @default(0)
  updatedAt     DateTime    @updatedAt
  productType   ProductType @relation(fields: [productTypeId], references: [id])
}

model StockLedgerEntry {
  id                  String      @id @default(uuid())
  productTypeId       String
  refType             String
  refNo               String?
  refId               String?
  qtyChangeKg         Float
  unitCostPerKg       Float?
  totalCost           Float?
  balanceQtyKg        Float
  balanceAvgCostPerKg Float
  date                DateTime
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  productType         ProductType @relation(fields: [productTypeId], references: [id])

  @@index([productTypeId])
  @@index([productTypeId, date, createdAt])
  @@index([date])
  @@index([refType])
  @@index([refId])
}
