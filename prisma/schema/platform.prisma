// This is your Prisma schema file

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
  binaryTargets = ["native", "windows", "darwin", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  email     String?
  address   String?
  plan      String   @default("freemium") // freemium | premium
  status    String   @default("active") // active | not_yet_payment | pending_payment | rejected
  industry  String   @default("rubber")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  members                  Member[]
  destinationCompanies     DestinationCompany[]
  productTypes             ProductType[]
  productPrices            ProductPrice[]
  purchases                Purchase[]
  expenses                 Expense[]
  serviceFees              ServiceFee[]
  settings                 Setting[]
  sales                    Sale[]
  stockPositions           StockPosition[]
  stockLedgerEntries       StockLedgerEntry[]
  stockGangs               StockGang[]
  reportProductTypeGroups  ReportProductTypeGroup[]
  paymentRequests          PaymentRequest[]

  @@index([status])
  @@index([plan])
  @@index([email])
}

model PendingSignup {
  id             String   @id @default(uuid())
  slug           String   @unique
  username       String
  passwordHash   String
  email          String
  companyName    String
  companyAddress String   @default("")
  plan           String
  tokenHash      String   @unique
  failedAttempts Int      @default(0)
  expiresAt      DateTime
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
}

model PlatformUser {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSettings {
  id              String   @id @default("default")
  bankName        String   @default("")
  accountName     String   @default("")
  accountNumber   String   @default("")
  promptPayId     String   @default("")
  qrImage         Bytes?
  qrImageMimeType String?
  premiumPriceThb Float    @default(0)
  updatedAt       DateTime @updatedAt
}

model PaymentRequest {
  id           String    @id @default(uuid())
  tenantId     String
  amount       Float
  status       String    @default("pending") // pending | approved | rejected
  slipImage    Bytes
  slipMimeType String
  note         String?
  rejectReason String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, createdAt])
}

model User {
  id        String     @id @default(uuid())
  tenantId  String
  username  String
  password  String
  role      String     @default("user") // root, admin, user, viewer
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases           Purchase[]
  sales               Sale[]
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, username])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}
